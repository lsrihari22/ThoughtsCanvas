<%- include("partials/header"); -%>

<div class="container mt-4">
  <h2 class="mb-3">Write a New Blog</h2>

  <form action="/compose" method="POST" class="compose-form">
    <input 
      type="text" 
      name="postTitle" 
      placeholder="Post title..." 
      class="form-control compose-title" 
      required
    >

    <textarea 
      name="postBody" 
      rows="10" 
      placeholder="Start writing your story..." 
      class="form-control compose-body" 
      required
    ></textarea>

    <button type="submit" class="btn btn-primary mt-3">Publish</button>
  </form>
</div>

<%- include("partials/footer"); -%>
